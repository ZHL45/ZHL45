<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.neusoft.mapper.DeliverMapper">
    <insert id="add" parameterType="cn.neusoft.domain.fenzhan.Deliver">
        insert into fenzhan_deliver values(#{taskid},#{postman},#{taskdate})
    </insert>

    <update id="update">
        update order_info_all set o_state="已完成" where o_id=#{o_id}

    </update>


</mapper>