<!--    发票联查-->
    <select id="findall2" resultType="cn.neusoft.domain.fenzhan.Bill">
        select * from fenzhan_bill b,order_info_all o where b.did=o.o_id
    </select>
    <resultMap id="test2" type="cn.neusoft.domain.fenzhan.Bill">
        <id column="did" property="did"/>
        <result column="endnum" property="endnum"/>
        <result column="batch" property="batch"/>
        <result column="opera" property="opera"/>
        <result column="hname" property="hname"/>
        <result column="startnum" property="startnum"/>
        <result column="date" property="date"/>
        <association property="bill_find" javaType="cn.neusoft.domain.fenzhan.Bill_find">
            <id column="o_id" property="o_id"/>
            <result column="p_amount" property="p_amount"/>
            <result column="o_receiver" property="o_receiver"/>
        </association>
    </resultMap>


<!-- 联查+分页-->
    <select id="findbypage2" resultMap="test2">
        select * from (
        select * from fenzhan_bill b,order_info_all o
        <where>
            <if test="true">
                b.did=o.o_id
            </if>
            <if test="hname!=null">
                AND b.hname LIKE CONCAT('%',#{hname},'%')
            </if>
            <if test="batch!=null and batch!=''">
                AND batch LIKE CONCAT('%',#{batch},'%')
            </if>
            <if test="startnum!=null and startnum!=''">
                startnum LIKE CONCAT('%',#{startnum},'%')
            </if>
            <if test="endnum!=null and endnum!=''">
                AND endnum LIKE CONCAT('%',#{endnum},'%')
            </if>
            <if test="date!=null">
                AND date LIKE CONCAT('%',#{date},'%')
            </if>
        </where>
        ) cond limit #{startIndex},#{pageSize}
    </select>
</mapper>