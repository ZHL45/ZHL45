<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.neusoft.mapper.BillMapper">
    <insert id="add" parameterType="cn.neusoft.domain.fenzhan.Bill">
        insert into fenzhan_bill values(#{startnum},#{endnum},#{batch},#{opera},#{hname},#{did},#{date})
    </insert>


    <delete id="delete">
        delete from fenzhan_bill where startnum=#{startnum} and endnum=#{endnum} and batch=#{batch}
    </delete>

<!--分页+模糊搜索-->

    <select id="findbypage" resultType="cn.neusoft.domain.fenzhan.Bill">
        select * from (select * from fenzhan_bill
        <where>
            <if test="startnum!=null and startnum!=''">
                startnum LIKE CONCAT('%',#{startnum},'%')
            </if>
            <if test="endnum!=null and endnum!=''">
                AND endnum LIKE CONCAT('%',#{endnum},'%')
            </if>
            <if test="batch!=null and batch!=''">
                AND batch LIKE CONCAT('%',#{batch},'%')
            </if>
            <if test="opera!=null and opera!=''">
                AND opera LIKE CONCAT('%',#{opera},'%')
            </if>
            <if test="hname!=null and hname!=''">
                AND hname LIKE CONCAT('%',#{hname},'%')
            </if>
            <if test="did!=null and did!=''">
                AND did LIKE CONCAT('%',#{did},'%')
            </if>
        </where>) cond limit #{startIndex},#{pageSize}
    </select>

    <select id="findbycondition" resultType="cn.neusoft.domain.fenzhan.Bill">
        select * from fenzhan_bill
        <where>
            <if test="startnum!=null and startnum!=''">
                startnum LIKE CONCAT('%',#{startnum},'%')
            </if>
            <if test="endnum!=null and endnum!=''">
                AND endnum LIKE CONCAT('%',#{endnum},'%')
            </if>
            <if test="batch!=null and batch!=''">
                AND batch LIKE CONCAT('%',#{batch},'%')
            </if>
            <if test="opera!=null and opera!=''">
                AND opera LIKE CONCAT('%',#{opera},'%')
            </if>
            <if test="hname!=null and hname!=''">
                AND hname LIKE CONCAT('%',#{hname},'%')
            </if>
            <if test="did!=null and did!=''">
                AND did LIKE CONCAT('%',#{did},'%')
            </if>
        </where>
    </select>
    
    
    
