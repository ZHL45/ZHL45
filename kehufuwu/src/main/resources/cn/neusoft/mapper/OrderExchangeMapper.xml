<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.neusoft.mapper.OrderExchangeMapper">


    <select id="findByPage" resultType="cn.neusoft.domain.order.OrderExchange">
        select * from order_info_exchange
        <where>
            <if test="c_name!=null and c_name!=''">
                c_name LIKE CONCAT('%',#{c_name},'%')
            </if>
            <if test="p_name!=null and p_name!=''">
                AND p_name LIKE CONCAT('%',#{p_name},'%')
            </if>
            <if test="o_id!=null and o_id!=''">
                AND o_id LIKE CONCAT('%',#{o_id},'%')
            </if>
        </where> order by o_id
    </select>

    <insert id="orderReturn" parameterType="cn.neusoft.domain.order.OrderReturn">
        insert into order_info_return
        values(#{o_id},#{o_l_id},#{c_name},#{p_name},#{p_number},#{p_amount},#{o_reason},#{o_address},#{o_state})
    </insert>

