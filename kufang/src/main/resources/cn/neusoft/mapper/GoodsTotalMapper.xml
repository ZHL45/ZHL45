<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.neusoft.mapper.GoodsTotalMapper">
    <update id="add">
        update kufang_total set cnum=#{cnum} where cid=#{cid}
    </update>

    <select id="findbyid" resultType="cn.neusoft.domain.kufang.Goods_Total">
        select * from kufang_total where cid=#{cid}
    </select>

    <insert id="first" parameterType="cn.neusoft.domain.kufang.Goods_Total">
        insert into kufang_total values(#{cid},#{cnum})
    </insert>
</mapper>