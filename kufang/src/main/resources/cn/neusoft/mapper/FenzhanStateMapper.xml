<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.neusoft.mapper.FenzhanStateMapper">
    <insert id="add" parameterType="cn.neusoft.domain.fenzhan.FenzhanState">
        insert into fenzhan_state values(#{tid},#{state})
    </insert>

    <select id="exist" resultType="Integer">
        SELECT COUNT(tid) FROM  fenzhan_state where tid=#{tid}
    </select>

    <update id="update">
        update fenzhan_state set state=#{state} where tid=#{tid}
    </update>
</mapper>