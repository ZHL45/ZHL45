    <select id="find" resultMap="test">
        select * from kufang_goods a,kufang_change b where b.allocateid=#{allocateid} and a.cid=b.cid
    </select>
    <resultMap id="test" type="cn.neusoft.domain.kufang.ChuKuDan">
        <id column="allocateid" property="allocateid"/>
        <result column="cid" property="cid"/>
        <result column="cname" property="cname"/>
        <result column="date" property="date"/>
        <result column="cnum" property="cnum"/>
        <association property="goods" javaType="cn.neusoft.domain.kufang.Goods">
            <result column="remark" property="note"/>
            <result column="factory" property="factory"/>
            <result column="original_price" property="original_price"/>
            <result column="factory" property="factory"/>
        </association>
    </resultMap>

    <select id="print" resultType="cn.neusoft.domain.kufang.Kufang_change1">
        select * from (select * from kufang_change1
        <where>
            <if test="start!=null">
                date>=#{start}
            </if>
            <if test="end!=null">
                AND #{end}>=date
            </if>
            <if test="name!=null and name!=''">
                AND cname LIKE CONCAT('%',#{name},'%')
            </if>
            <if test="station!=null and station!=''">
                AND fzname LIKE CONCAT('%',#{station},'%')
            </if>
            <if test="true">
                AND 0 >cnum
            </if>
        </where>) cond limit #{startIndex},#{pageSize}
    </select>

    <select id="findgoods" resultType="cn.neusoft.domain.kufang.Goods">
        select * from kufang_goods where cid=#{cid}
    </select>


    <select id="print1" resultType="cn.neusoft.domain.kufang.ChuKuDan">
<!--        select * from kufang_vo where station="分站入" or station="中心出"-->

        select * from (select * from kufang_vo
        <where>
            <if test="start!=null">
                date>=#{start}
            </if>
            <if test="end!=null">
                AND #{end}>=date
            </if>
            <!--            <if test="true">-->
            <!--                AND 0>cnum-->
            <!--            </if>-->
            <if test="name!=null and name!=''">
                AND cname LIKE CONCAT('%',#{name},'%')
            </if>
<!--            <if test="true">-->
<!--                AND 0 >cnum-->
<!--            </if>-->
            <if test="true">
                AND (station="分站入" or station="中心出")
            </if>
        </where>) cond limit #{startIndex},#{pageSize}
    </select>

    <select id="findc" resultType="String">
        select c_name from order_info_all where o_id=#{o_id}
    </select>

