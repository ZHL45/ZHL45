<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.neusoft.mapper.GoodsChangeMapper">
    <insert id="add" parameterType="cn.neusoft.domain.kufang.Goods_Change">
        insert into kufang_change values (#{allocateid}, #{cid}, #{cname}, #{measure_unit}, #{cnum}, #{tid}, #{date})
    </insert>

    <insert id="add_follow1" parameterType="cn.neusoft.domain.kufang.Goods_Change">
        insert into kufang_vo values (#{allocateid}, #{cid}, #{cname}, #{measure_unit}, #{cnum}, #{tid}, #{date},"中心入")
    </insert>
    <update id="add_follow2">
        update kufang_goods1 set is_jinhuo="已进货" where o_id=#{integer}
    </update>


    <insert id="add2" parameterType="cn.neusoft.domain.kufang.Goods_Change">
        insert into kufang_change values(#{allocateid},#{cid},#{cname},#{measure_unit},#{cnum},#{tid},#{date})

    </insert>
    <update id="add2_follow1">
        update kufang_vo set station="中心出" where allocateid=#{allocateid}
    </update>


    <update id="updatestate">
        update order_info_all set o_state="中心库房出库" where o_id=#{integer}
    </update>

<!--中心库房的两个模糊+分页查询-->
    <select id="findbypage" resultType="cn.neusoft.domain.kufang.KufangGoods1">
        SELECT * FROM kufang_goods1 WHERE is_jinhuo is NULL or is_jinhuo='未进货'
    </select>

    <select id="findbypage2" resultType="cn.neusoft.domain.kufang.Goods_Change">
        select * from (select * from kufang_vo
        <where>
            <if test="start!=null">
                date>=#{start}
            </if>
            <if test="end!=null">
                AND #{end}>=date
            </if>
            <if test="true">
                AND cnum>0
            </if>
            <if test="true">
                AND kufang_vo.station="中心入"
            </if>
        </where>) cond limit #{startIndex},#{pageSize}
    </select>

    <select id="findbypage3" resultType="cn.neusoft.domain.kufang.Goods_Change">
